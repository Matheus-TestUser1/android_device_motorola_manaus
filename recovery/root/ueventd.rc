# ueventd.rc - Motorola Edge 40 Neo (manaus)
# Based on Motorola stock vendor
# TWRP specific configuration

firmware_directories /etc/firmware/ /odm/firmware/ /vendor/firmware/ /firmware/image/
uevent_socket_rcvbuf_size 16M

# -------------------------------------------------------
# SUBSYSTEMS
# -------------------------------------------------------

subsystem graphics
    devname uevent_devpath
    dirname /dev/graphics

subsystem drm
    devname uevent_devpath
    dirname /dev/dri

subsystem input
    devname uevent_devpath
    dirname /dev/input

subsystem dma_heap
    devname uevent_devpath
    dirname /dev/dma_heap

# -------------------------------------------------------
# CORE
# -------------------------------------------------------

/dev/null          0666 root root
/dev/zero          0666 root root
/dev/full          0666 root root
/dev/random        0666 root root
/dev/urandom       0666 root root
/dev/tty           0666 root root
/dev/ptmx          0666 root root

/dev/binder        0666 root root
/dev/hwbinder      0666 root root
/dev/vndbinder     0666 root root

# -------------------------------------------------------
# STORAGE
# -------------------------------------------------------

/dev/block/mmcblk0*      0660 root system
/dev/block/sd*           0660 root system
/dev/block/dm-*          0660 root system
/dev/block/mapper/*      0660 root system
/dev/block/by-name/*     0660 root system

# -------------------------------------------------------
# INPUT
# -------------------------------------------------------

/dev/input/*             0660 system input
/dev/touch               0660 root system
/dev/goodix_ts           0660 system input
/dev/goodix_fp           0660 system system
/dev/hotknot             0660 root system
/dev/i2c-*               0660 system system

# -------------------------------------------------------
# GRAPHICS
# -------------------------------------------------------

/dev/graphics/*          0660 system graphics
/dev/dri/*               0660 system graphics
/dev/mali0               0666 system graphics
/dev/pvrsrvkm            0666 system graphics
/dev/ion                 0666 system graphics

# -------------------------------------------------------
# DMA HEAP
# -------------------------------------------------------

/dev/dma_heap/system                             0666 system system
/dev/dma_heap/system-uncached                    0666 system system

/dev/dma_heap/mtk_*                              0444 system system

# -------------------------------------------------------
# USB
# -------------------------------------------------------

/dev/bus/usb/*           0660 root usb
/dev/android_adb         0660 system adb
/dev/mtp_usb             0660 system mtp
/dev/usb_accessory       0660 system usb

/dev/ttyUSB*             0660 radio radio
/dev/ttyACM*             0660 radio radio

# -------------------------------------------------------
# MISC DEVICES
# -------------------------------------------------------

/dev/uhid                0660 uhid uhid
/dev/uinput              0660 uhid uhid
/dev/tun                 0660 system vpn
/dev/hidraw*             0660 system system
/dev/rtc0                0640 system system
/dev/snd/*               0660 system audio
/dev/v4l-touch*          0660 root input

# -------------------------------------------------------
# CONNECTIVITY
# -------------------------------------------------------

/dev/stp*                0660 system system
/dev/wmt*                0660 system system
/dev/fw_log_*            0660 system system
/dev/conn*               0660 system system

/dev/stpbt               0660 bluetooth bluetooth

/dev/gps*                0660 gps gps
/dev/stpgps              0660 gps gps

/dev/wmtWifi             0660 wifi wifi

/dev/fm                  0660 media media

/dev/st21nfc             0660 nfc radio
/dev/st54spi             0660 secure_element secure_element
/dev/nq-nci              0666 nfc nfc
/dev/p73                 0666 secure_element secure_element

/dev/btif                0600 system system

# -------------------------------------------------------
# TEE
# -------------------------------------------------------

/dev/trusty-ipc-dev0     0660 system system
/dev/nebula-ipc-dev0     0660 system system
/dev/mobicore            0600 system system
/dev/mobicore-user       0666 system system
/dev/t-base-tui          0666 system system
/dev/teeperf             0666 system system

# -------------------------------------------------------
# CAMERA
# -------------------------------------------------------

/dev/video*              0660 camera system
/dev/media*              0660 camera system
/dev/v4l-subdev*         0660 camera system
/dev/vcu                 0660 camera system
/dev/vdec-fmt            0660 media system
/dev/fmt_sync            0660 system system
/dev/mtk_hcp             0660 camera system
/dev/camera_eeprom*      0660 system camera
/dev/ccu*                0660 system camera

# -------------------------------------------------------
# MODEM
# -------------------------------------------------------

/dev/ccci*               0660 radio radio
/dev/ttyC*               0660 radio radio
/dev/eemcs*              0660 radio radio
/dev/emd*                0660 radio radio
/dev/ttySDIO*            0660 radio sdcard_rw
/dev/ttyRB*              0660 radio radio

# -------------------------------------------------------
# MEDIATEK HAL
# -------------------------------------------------------

/dev/mtk_*               0660 system system
/dev/pmicsys             0660 system system

# -------------------------------------------------------
# SYSFS
# -------------------------------------------------------

/sys/class/leds/lcd-backlight/brightness                         0664 system system

/sys/devices/virtual/input/input* enable                         0660 root input
/sys/devices/virtual/input/input* poll_delay                     0660 root input

# MediaTek I2C touch (Goodix via 11ed1000.i2c bus 5)
/sys/devices/platform/11ed1000.i2c/i2c-5/5-0034/input/input* enable              0660 root input
/sys/devices/platform/11ed1000.i2c/i2c-5/5-0034/input/input* poll_delay          0660 root input
/sys/devices/platform/11ed1000.i2c/i2c-5/5-0014/input/input* enable              0660 root input
/sys/devices/platform/11ed1000.i2c/i2c-5/5-0014/input/input* poll_delay          0660 root input

/sys/devices/platform/soc/*/i2c*/i2c-*/* reg                     0660 root input
/sys/devices/platform/soc/*/i2c*/i2c-*/* power                   0660 root input

/sys/devices/platform/soc/*/i2c*/i2c-*/*/goodix_ts reset         0660 system input
/sys/devices/platform/soc/*/i2c*/i2c-*/*/goodix_ts irq_enabled   0660 system input

/sys/devices/virtual/usb_composite/* enable                      0664 root system

/sys/devices/system/cpu/cpu* cpufreq/scaling_max_freq            0664 system system
/sys/devices/system/cpu/cpu* cpufreq/scaling_min_freq            0664 system system

/sys/devices/virtual/misc/uhid/*/leds/* brightness               0664 system system
/sys/devices/virtual/misc/uhid/*/leds/* multi_intensity          0664 system system

/sys/devices/platform/trusty.* trusty_version                    0440 root log

/sys/kernel/ccci modem_info                                      0644 radio radio
/sys/kernel/ccci md1_postfix                                     0644 radio radio
/sys/kernel/ccci md2_postfix                                     0644 radio radio
