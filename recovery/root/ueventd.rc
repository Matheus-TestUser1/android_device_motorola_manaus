# ueventd.rc - Motorola Edge 40 Neo (manaus) - MT6879
# TWRP Recovery - VERSÃO ESSENCIAL ORGANIZADA
# MediaTek MT6879 - Mali GPU - A/B Partitions

# ════════════════════════════════════════════════════════════════
# FIRMWARE DIRECTORIES
# ════════════════════════════════════════════════════════════════
firmware_directories /etc/firmware/ /odm/firmware/ /vendor/firmware/ /firmware/image/
uevent_socket_rcvbuf_size 16M

# ════════════════════════════════════════════════════════════════
# SUBSYSTEMS
# ════════════════════════════════════════════════════════════════
subsystem graphics
    devname uevent_devpath
    dirname /dev/graphics

subsystem drm
    devname uevent_devpath
    dirname /dev/dri

subsystem input
    devname uevent_devpath
    dirname /dev/input

subsystem dma_heap
    devname uevent_devpath
    dirname /dev/dma_heap

# ════════════════════════════════════════════════════════════════
# CORE DEVICES
# ════════════════════════════════════════════════════════════════
/dev/null                 0666   root       root
/dev/zero                 0666   root       root
/dev/full                 0666   root       root
/dev/ptmx                 0666   root       root
/dev/tty                  0666   root       root
/dev/random               0666   root       root
/dev/urandom              0666   root       root
/dev/binder               0666   root       root
/dev/hwbinder             0666   root       root
/dev/vndbinder            0666   root       root

# ════════════════════════════════════════════════════════════════
# GRAPHICS/DISPLAY (CRITICAL FOR TWRP!)
# ════════════════════════════════════════════════════════════════
/dev/graphics/*           0660   system     graphics
/dev/dri/*                0660   system     graphics
/dev/mali0                0666   system     graphics
/dev/ion                  0666   system     graphics

/dev/block/mmcblk0                               0660    root    system
/dev/block/mmcblk0boot0                          0660    root    system
/dev/block/mmcblk0boot1                          0660    root    system
# ════════════════════════════════════════════════════════════════
# DMA_HEAP (CRITICAL FOR GPU/DISPLAY!)
# ════════════════════════════════════════════════════════════════
/dev/dma_heap/system                             0444   system   system
/dev/dma_heap/system-uncached                    0444   system   system
/dev/dma_heap/mtk_mm                             0444   system   system
/dev/dma_heap/mtk_mm-uncached                    0444   system   system
/dev/dma_heap/mtk_svp_page-uncached              0444   system   system
/dev/dma_heap/mtk_prot_page-uncached             0444   system   system
/dev/dma_heap/mtk_svp_region                     0444   system   system
/dev/dma_heap/mtk_svp_region-aligned             0444   system   system
/dev/dma_heap/mtk_prot_region                    0444   system   system
/dev/dma_heap/mtk_prot_region-aligned            0444   system   system
/dev/dma_heap/mtk_2d_fr_region                   0444   system   system
/dev/dma_heap/mtk_2d_fr_region-aligned           0444   system   system
/dev/dma_heap/mtk_wfd_region                     0444   system   system
/dev/dma_heap/mtk_wfd_region-aligned             0444   system   system
/dev/dma_heap/mtk_wfd_page-uncached              0444   system   system
/dev/dma_heap/mtk_sapu_data_shm_region           0444   system   system
/dev/dma_heap/mtk_sapu_data_shm_region-aligned   0444   system   system
/dev/dma_heap/mtk_sapu_engine_shm_region         0444   system   system
/dev/dma_heap/mtk_sapu_engine_shm_region-aligned 0444   system   system

# ════════════════════════════════════════════════════════════════
# INPUT/TOUCH (CRITICAL FOR TWRP!)
# ════════════════════════════════════════════════════════════════
/dev/input/*              0660   system     input
/dev/touch                0660   root       system
/sys/class/*              0660   root       input 
# ════════════════════════════════════════════════════════════════
# BLOCK DEVICES (CRITICAL FOR TWRP!)
# ════════════════════════════════════════════════════════════════
# eMMC/UFS storage
/dev/block/mmcblk0*       0660   root       system
/dev/block/sda            0660   root       system
/dev/block/sdb            0660   root       system
/dev/block/sdc            0660   root       system

# Device mapper
/dev/block/dm-*           0660   root       system
/dev/block/mapper/*       0660   root       system

# By-name partitions
/dev/block/by-name/*      0660   root       system
# Change ION driver permission
/dev/ion                  0666   system     graphics
# add the read write right of ttyUSB*
/dev/bus/usb/*     	  0660   root       usb
/dev/bus/usb/*     	  0660   root       usb
/dev/ttyUSB0              0660   radio      radio
/dev/ttyUSB1              0660   radio      radio
/dev/ttyUSB2              0660   radio      radio
/dev/ttyUSB3              0660   radio      radio
/dev/ttyUSB4              0660   radio      radio
/dev/misc-sd                                     0660    root    system
# DRM node
/dev/dri/card0            0660   system     system

#FOR VIA MODEM
/dev/ttySDIO*             0660   radio      sdcard_rw
/dev/ttyRB*               0660   radio      radio

#touch
/dev/touch                0660   root       system
/dev/hotknot              0660   root       system
# ════════════════════════════════════════════════════════════════
# USB (CRITICAL FOR ADB!)
# ════════════════════════════════════════════════════════════════
/dev/bus/usb/*            0660   root       usb
/dev/mtp_usb              0660   root       mtp

# ════════════════════════════════════════════════════════════════
# SYSFS PROPERTIES (CRITICAL!)
# ════════════════════════════════════════════════════════════════
# Backlight
/sys/class/leds/lcd-backlight/brightness         0664   system   system

# Input devices
/sys/devices/virtual/input/input*/enable         0660   root     input
/sys/devices/virtual/input/input*/poll_delay     0660   root     input

# Touch sensors (Motorola CapSense)
/sys/class/sensors/Moto\ CapSense\ Ch*/enable       0660   root   input
/sys/class/sensors/Moto\ CapSense\ Ch*/poll_delay   0660   root   input

# LEDs
/sys/devices/platform/leds-mt65xx/leds/*/delay_on    0664   system   system
/sys/devices/platform/leds-mt65xx/leds/*/delay_off   0664   system   system

# ════════════════════════════════════════════════════════════
# INPUT DEVICES - GOODIX TOUCH
# ════════════════════════════════════════════════════════════

# Event devices
/dev/input/event*          0660   system     input
/dev/input/mice            0660   system     input
/dev/input/mouse*          0660   system     input

# Goodix touch device
/dev/goodix_ts             0660   system     input
/dev/touch*                0660   system     input

# I2C for Goodix (CRÍTICO!)
/dev/i2c-0                 0660   system     system
/dev/i2c-1                 0660   system     system
/dev/i2c-2                 0660   system     system
/dev/i2c-3                 0660   system     system
/dev/i2c-4                 0660   system     system
/dev/i2c-5                 0660   system     system
/dev/i2c-6                 0660   system     system
/dev/i2c-7                 0660   system     system

# Goodix firmware loading (CRÍTICO!)
/sys/devices/platform/soc/*/i2c.*/i2c-*/i-*/input/input*           enable      0660  root   input
/sys/devices/platform/soc/*/i2c*/i2c-*/*/input/input*/enable       0660  root   input
/sys/devices/virtual/input/input*/enable                           0660  root   input

# Goodix calibration/reset
/sys/devices/platform/soc/*/i2c*/i2c-*/*/goodix_ts/reset           0660  system input
/sys/devices/platform/soc/*/i2c*/i2c-*/*/goodix_ts/irq_enabled     0660  system input

# ════════════════════════════════════════════════════════════
# MTP/USB
# ════════════════════════════════════════════════════════════

/dev/mtp_usb               0660   system     mtp
/dev/usb_accessory         0660   system     usb
/dev/android_adb           0660   system     adb
