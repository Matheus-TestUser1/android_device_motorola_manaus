# snapuserd.rc
# Snapuserd daemon for Virtual A/B compression
# Motorola Edge 40 Neo (manaus) - MT6879

# Snapuserd daemon (CRITICAL for Virtual A/B with compression!)
service snapuserd /system/bin/snapuserd
    socket snapuserd stream 0660 system system
    user root
    group system
    class core
    seclabel u:r:recovery:s0

# Start snapuserd when needed
on property:ro.virtual_ab.enabled=true
    start snapuserd

on property:ro.virtual_ab.compression.enabled=true
    start snapuserd
