# mtk-plpath-utils.rc
# MediaTek plpath utilities for TWRP Recovery
# Motorola Edge 40 Neo (manaus) - MT6879 - UFS + Virtual A/B
# 
# IMPORTANTE: Nome do serviço mantido conforme esperado pela MediaTek
# O binário foi renomeado para plpath_utils, mas o serviço usa nome MTK padrão

on early-init
    # Criar estrutura de diretórios essencial
    mkdir /dev/block 0755 root root
    mkdir /dev/block/platform 0755 root root
    mkdir /dev/block/platform/mtk-msdc.0 0755 root root
    mkdir /dev/block/platform/mtk-msdc.0/by-name 0755 root root
    mkdir /dev/block/by-name 0755 root root
    mkdir /dev/block/mapper 0755 root root
    
    # Symlinks essenciais para bootdevice
    symlink /dev/block/platform/mtk-msdc.0 /dev/block/bootdevice
    symlink /dev/block/platform/mtk-msdc.0/by-name /dev/block/by-name
    
    # Iniciar serviço MTK (nome fixo!)
    start mtk.plpath.utils.link

on post-fs
    # Preloader symlinks - UFS (sda/sdb confirmado stock)
    symlink /dev/block/sda /dev/block/by-name/preloader_a
    symlink /dev/block/sdb /dev/block/by-name/preloader_b
    symlink /dev/block/sda /dev/block/platform/mtk-msdc.0/by-name/preloader_a
    symlink /dev/block/sdb /dev/block/platform/mtk-msdc.0/by-name/preloader_b
    
    # Preloader raw (pl_a/pl_b do mapper)
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/mtk-msdc.0/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/mtk-msdc.0/by-name/preloader_raw_b
    
    # Bootloader symlinks (lk1/lk2)
    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2
    symlink /dev/block/by-name/lk1 /dev/block/platform/mtk-msdc.0/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/platform/mtk-msdc.0/by-name/bootloader2

# ============================================================================
# NOME DO SERVIÇO: mtk.plpath.utils.link (conforme esperado pela MediaTek!)
# ============================================================================
# O binário é plpath_utils (renomeado), mas o serviço mantém nome MTK padrão
service mtk.plpath.utils.link /system/bin/plpath_utils
    class main
    user root
    group root system
    oneshot
    seclabel u:r:recovery:s0
