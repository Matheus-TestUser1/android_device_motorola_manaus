# recovery.fstab - Motorola Edge 40 Neo (manaus) - MT6879
# TWRP Recovery - MOUNT POINTS CORRETOS

# ════════════════════════════════════════════════════════════════
# SYSTEM PARTITIONS (Dynamic - Super)
# ════════════════════════════════════════════════════════════════

system         /system              erofs    ro    wait,slotselect,logical,first_stage_mount         display="System";logical;slotselect
system         /system              ext4     ro    wait,slotselect,logical,first_stage_mount         display="System";logical;slotselect
system_ext     /system_ext          erofs    ro    wait,slotselect,logical,first_stage_mount         display="System_EXT";logical;slotselect
vendor         /vendor              erofs    ro    wait,slotselect,logical,first_stage_mount         display="Vendor";logical;slotselect
product        /product             erofs    ro    wait,slotselect,logical,first_stage_mount         display="Product";logical;slotselect
vendor_dlkm    /vendor_dlkm         erofs    ro    wait,slotselect,logical,first_stage_mount         display="Vendor_DLKM";logical;slotselect

# ════════════════════════════════════════════════════════════════
# DATA PARTITION (F2FS + EXT4 FALLBACK)
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/userdata    /data    f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt    wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset
/dev/block/by-name/userdata    /data    ext4    noatime,nosuid,nodev,noauto_da_alloc                                                                           wait,check,formattable,quota,latemount,resize,reservedsize=128m,flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset

# ════════════════════════════════════════════════════════════════
# METADATA
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/metadata    /metadata    ext4    noatime,nosuid,nodev,discard    wait,check,formattable,first_stage_mount,flags=display="Metadata";backup=1;wipeingui

# ════════════════════════════════════════════════════════════════
# CACHE / DALVIK
# ════════════════════════════════════════════════════════════════

/data/cache                    /cache       ext4    noatime,nosuid,nodev                            flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset

# ════════════════════════════════════════════════════════════════
# BOOT PARTITIONS (A/B)
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/boot        /boot        emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="Boot";backup=1;flashimg=1;slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="Vendor_Boot";backup=1;flashimg=1;slotselect
/dev/block/by-name/dtbo        /dtbo        emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="DTBO";backup=1;flashimg=1;slotselect

# ════════════════════════════════════════════════════════════════
# VBMETA (A/B)
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/vbmeta        /vbmeta        emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="VBMeta";backup=1;flashimg=1;slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="VBMeta_System";backup=1;flashimg=1;slotselect
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc    defaults    first_stage_mount,nofail,slotselect,flags=display="VBMeta_Vendor";backup=1;flashimg=1;slotselect

# ════════════════════════════════════════════════════════════════
# VENDOR-SPECIFIC PARTITIONS (MediaTek) - ⭐ MOUNT POINTS CORRETOS!
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/nvdata      /mnt/vendor/nvdata      ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="NVData";backup=1;wipeingui
/dev/block/by-name/nvcfg       /mnt/vendor/nvcfg       ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="NVCfg";backup=1;wipeingui
/dev/block/by-name/persist     /mnt/vendor/persist     ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="Persist";backup=1;wipeingui
/dev/block/by-name/prodpersist /mnt/product/persist    ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="ProdPersist";backup=1

# ⭐⭐⭐ PROTECT PARTITIONS - MOUNT POINTS CORRETOS! ⭐⭐⭐
/dev/block/by-name/protect1    /mnt/vendor/protect_f   ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="Protect_F";backup=1
/dev/block/by-name/protect2    /mnt/vendor/protect_s   ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,flags=display="Protect_S";backup=1

/dev/block/by-name/tzapp       /mnt/vendor/tzapp       ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,slotselect,flags=display="TZ_App";backup=1;slotselect

# ════════════════════════════════════════════════════════════════
# PERSISTENT DATA
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/misc        /misc        emmc    defaults    defaults,flags=display="Misc"
/dev/block/by-name/frp         /persistent  emmc    defaults    defaults,flags=display="FRP"
/dev/block/by-name/nvram       /nvram       emmc    defaults    defaults,flags=display="NVRAM";backup=1;flashimg=1
/dev/block/by-name/proinfo     /proinfo     emmc    defaults    defaults,flags=display="Proinfo";backup=1
/dev/block/by-name/para        /para        emmc    defaults    defaults,flags=display="Para";backup=1
/dev/block/by-name/seccfg      /seccfg      emmc    defaults    defaults,flags=display="SecCfg";backup=1

# ════════════════════════════════════════════════════════════════
# BOOTLOADER
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/lk          /bootloader  emmc    defaults    defaults,slotselect,flags=display="Bootloader";backup=1;flashimg=1;slotselect
/dev/block/by-name/lk2         /bootloader2 emmc    defaults    defaults,slotselect,flags=display="Bootloader2";backup=1;flashimg=1;slotselect

# ════════════════════════════════════════════════════════════════
# LOGOS / GRAPHICS
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/logo        /logo        emmc    defaults    defaults,flags=display="Logo";backup=1;flashimg=1
/dev/block/by-name/expdb       /expdb       emmc    defaults    defaults,flags=display="ExpDB"

# ════════════════════════════════════════════════════════════════
# MODEM / DSP
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/md1img      /md1img      emmc    defaults    defaults,flags=display="Modem";backup=1;flashimg=1
/dev/block/by-name/md1dsp      /md1dsp      emmc    defaults    defaults,flags=display="Modem_DSP";backup=1;flashimg=1
/dev/block/by-name/md1arm7     /md1arm7     emmc    defaults    defaults,flags=display="Modem_ARM7";backup=1;flashimg=1
/dev/block/by-name/md3img      /md3img      emmc    defaults    defaults,flags=display="Modem3";backup=1;flashimg=1

# ════════════════════════════════════════════════════════════════
# TRUSTZONE / SECURE BOOT
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/tee1        /tee1        emmc    defaults    defaults,flags=display="TEE1";backup=1;flashimg=1
/dev/block/by-name/tee2        /tee2        emmc    defaults    defaults,flags=display="TEE2";backup=1;flashimg=1

# ════════════════════════════════════════════════════════════════
# MEDIATEK CO-PROCESSORS
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/scp1        /scp1        emmc    defaults    defaults,flags=display="SCP1";backup=1;flashimg=1
/dev/block/by-name/scp2        /scp2        emmc    defaults    defaults,flags=display="SCP2";backup=1;flashimg=1
/dev/block/by-name/sspm_1      /sspm_1      emmc    defaults    defaults,flags=display="SSPM1";backup=1;flashimg=1
/dev/block/by-name/sspm_2      /sspm_2      emmc    defaults    defaults,flags=display="SSPM2";backup=1;flashimg=1
/dev/block/by-name/dpm_1       /dpm_1       emmc    defaults    defaults,flags=display="DPM1";backup=1;flashimg=1
/dev/block/by-name/dpm_2       /dpm_2       emmc    defaults    defaults,flags=display="DPM2";backup=1;flashimg=1
/dev/block/by-name/mcupm_1     /mcupm_1     emmc    defaults    defaults,flags=display="MCUPM1";backup=1;flashimg=1
/dev/block/by-name/mcupm_2     /mcupm_2     emmc    defaults    defaults,flags=display="MCUPM2";backup=1;flashimg=1

# ════════════════════════════════════════════════════════════════
# OTHER FIRMWARE
# ════════════════════════════════════════════════════════════════

/dev/block/by-name/gz1         /gz1         emmc    defaults    defaults,flags=display="GZ1";backup=1;flashimg=1
/dev/block/by-name/gz2         /gz2         emmc    defaults    defaults,flags=display="GZ2";backup=1;flashimg=1
/dev/block/by-name/spmfw       /spmfw       emmc    defaults    defaults,flags=display="SPMFW";backup=1;flashimg=1
/dev/block/by-name/audio_dsp   /audio_dsp   emmc    defaults    defaults,flags=display="Audio_DSP";backup=1;flashimg=1
/dev/block/by-name/pi_img      /pi_img      emmc    defaults    defaults,flags=display="PI_IMG";backup=1;flashimg=1
/dev/block/by-name/boot_para   /boot_para   emmc    defaults    defaults,flags=display="Boot_Para";backup=1
/dev/block/by-name/odmdtbo     /odmdtbo     emmc    defaults    defaults,flags=display="ODM_DTBO";backup=1;flashimg=1
/dev/block/by-name/otp         /otp         emmc    defaults    defaults,flags=display="OTP";backup=1
/dev/block/by-name/efuse       /efuse       emmc    defaults    defaults,flags=display="eFuse"

# ════════════════════════════════════════════════════════════════
# USB OTG
# ════════════════════════════════════════════════════════════════

/devices/platform/soc/11201000.usb0/11200000.xhci*    auto    vfat    defaults    voldmanaged=usbotg:auto,flags=storage;wipeingui;removable;fsflags=utf8
/devices/platform/usb_xhci*                           auto    vfat    defaults    voldmanaged=usbotg:auto,flags=storage;wipeingui;removable;fsflags=utf8
