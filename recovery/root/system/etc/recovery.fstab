odm                                                 /odm                  erofs    ro                                                                                                              wait,slotselect,avb,logical,first_stage_mount
odm                                                 /odm                  ext4     ro                                                                                                              wait,slotselect,avb,logical,first_stage_mount
/dev/block/by-name/metadata                         /metadata             ext4     noatime,nosuid,nodev,discard                                                                                    wait,check,formattable
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065 wait,check,formattable,quota,resize,reservedsize=128m,checkpoint=fs
/dev/block/by-name/misc                             /misc                 emmc     defaults                                                                                                        defaults
/dev/block/by-name/boot                             /boot                 emmc     defaults                                                                                                        first_stage_mount,nofail,slotselect
