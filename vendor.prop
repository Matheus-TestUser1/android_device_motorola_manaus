# vendor.prop - Motorola Edge 40 Neo (manaus) - MT6879
# TWRP Recovery - Vendor Boot

# ════════════════════════════════════════════════════════════════════════
# STORAGE
# Confirmado: ro.vendor.mtk_f2fs_enable=1 no vendor.prop original
# ════════════════════════════════════════════════════════════════════════
ro.vendor.mtk_f2fs_enable=1
ro.vendor.mtk_emmc_support=1
ro.vendor.mtk_ufs_support=1

# Crypto
#ro.crypto.volume.filenames_mode=aes-256-cts

# ════════════════════════════════════════════════════════════════════════
# USB
# Confirmado: vendor.usb.use_ffs_mtp=1 no vendor.prop original
# persist.sys.usb.config fica apenas no system.prop (sem duplicata)
# ════════════════════════════════════════════════════════════════════════
persist.vendor.usb.config=mtp
persist.vendor.usb.config.extra=none
vendor.usb.use_ffs_mtp=1

# ════════════════════════════════════════════════════════════════════════
# DISPLAY/GRAPHICS
# ro.sf.lcd_density e ro.minui.pixel_format ficam no system.prop (sem duplicata)
# ════════════════════════════════════════════════════════════════════════
ro.vendor.graphics.memory=4096
ro.vendor.mtk_gpu_support=1

# ════════════════════════════════════════════════════════════════════════
# SECURITY
# ro.adb.secure e ro.secure ficam no system.prop (sem duplicata)
# ════════════════════════════════════════════════════════════════════════
ro.vendor.boot.warranty_bit=0
ro.vendor.warranty_bit=0
