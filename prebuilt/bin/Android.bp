soong_namespace {
}

// 1. Binário Principal e seus Symlinks (MTK)
cc_prebuilt_binary {
    name: "plpath_utils",
    srcs: ["plpath_utils"],
    vendor_ramdisk: true,
    relative_install_path: "system/bin",
    strip: {
        none: true,
    },
    compile_multilib: "64",
    check_elf_files: false,

    // Cria os links mtk_plpath_utils e mtk_plpath_utils_ota automaticamente
    symlinks: [
        "mtk_plpath_utils",
        "mtk_plpath_utils_ota",
    ],
}

---

// 2. Snapuserd (Mantido de forma independente conforme solicitado)
cc_prebuilt_binary {
    name: "snapuserd",
    srcs: ["snapuserd"],
    vendor_ramdisk: true,
    relative_install_path: "system/bin",
    strip: {
        none: true,
    },
    compile_multilib: "64",
    check_elf_files: false,
}
