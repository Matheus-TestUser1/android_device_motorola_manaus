# Android.bp em device/motorola/manaus/prebuilt/bin/
soong_namespace {
}

cc_prebuilt_binary {
    name: "plpath_utils",
    srcs: ["plpath_utils"],
    
    // CRÍTICO: vendor_ramdisk para vendor_boot v4!
    vendor_ramdisk: true,
    
    // Caminho dentro do vendor ramdisk
    relative_install_path: "system/bin",
    
    // Preserve binary
    strip: {
        none: true,
    },
    
    // 64-bit para ARM64
    compile_multilib: "64",
    
    // Não é módulo proprietário/vendor
    proprietary: false,
    vendor: false,
    
    // Se precisar de init.rc junto:
    // init_rc: ["mtk-plpath-utils.rc"],
}

cc_prebuilt_binary {
    name: "snapuserd",
    srcs: ["snapuserd"],
    vendor_ramdisk: true,
    relative_install_path: "system/bin",
    strip: { none: true },
    compile_multilib: "64",
    check_elf_files: false,
}
