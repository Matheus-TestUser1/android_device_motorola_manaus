soong_namespace {
}

cc_prebuilt_binary {
    name: "plpath_utils",
    srcs: ["plpath_utils"],
    
    // Recovery installation
    recovery: true,
    
    // Path específico no recovery
    relative_install_path: "system/bin",
    
    // Preserve binary
    strip: {
        none: true,
    },
    
    // Permissions
    compile_multilib: "64",
    
    // Não vendor (conflita com recovery)
    proprietary: false,
}
